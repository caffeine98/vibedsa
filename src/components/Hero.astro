---
// Replaces Starlight's Hero. Used only on the home page.
// The figure is a real binary search step, not decoration.
import { getCollection } from 'astro:content';
import AiNotice from './AiNotice.astro';
import ArrayFigure from './ArrayFigure.astro';
import { curriculum } from '../data/curriculum.mjs';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline } = data.hero || {};

// "Start reading" goes to the first written lesson in curriculum order.
const written = new Set((await getCollection('docs')).map((entry) => entry.id));
const first = curriculum.flatMap((s) => s.topics).find((t) => written.has(t.slug));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="vd-hero not-content">
	<div class="vd-hero__text">
		<AiNotice />
		<p class="vd-kicker">Data structures &amp; algorithms · a field guide</p>
		<h1 id="_top" set:html={title} />
		{tagline && <p class="vd-tagline" set:html={tagline} />}
		<div class="vd-actions">
			{first && <a class="vd-btn vd-btn--primary" href={`${base}/${first.slug}/`}>Start reading: {first.title} →</a>}
			<a class="vd-btn" href={`${base}/guide/`}>How to read this site</a>
		</div>
	</div>

	<ArrayFigure
		values={[2, 5, 8, 12, 16, 23, 38]}
		caption="fig. 1 — binary search, step 1 · target = 23"
		pointers={{ 0: 'lo', 3: 'mid', 6: 'hi' }}
		active={3}
		dimmed={[0, 1, 2]}
		note="23 &gt; 12, so the target is right of mid. Drop the left half."
	/>
</div>

<style>
	.vd-hero {
		display: grid;
		gap: 2.5rem;
		padding-block: 2.5rem 1rem;
		align-items: end;
	}
	@media (min-width: 60rem) {
		.vd-hero {
			grid-template-columns: 1.15fr 1fr;
			padding-block: 4rem 1.5rem;
		}
	}
	.vd-hero :global(.vd-figure) {
		margin: 0;
	}
	.vd-kicker {
		margin: 0 0 1rem;
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--vd-mark);
	}
	h1 {
		font-family: var(--vd-font-display);
		font-size: clamp(2.5rem, 6vw, 4.25rem);
		font-weight: 600;
		line-height: 1.02;
		letter-spacing: -0.025em;
		color: var(--sl-color-white);
		margin: 0;
	}
	.vd-tagline {
		margin: 1.25rem 0 0;
		max-width: 34ch;
		font-size: var(--sl-text-lg);
		color: var(--sl-color-gray-2);
	}
	.vd-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}
	.vd-btn {
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		padding: 0.6rem 1rem;
		border: 1px solid var(--sl-color-gray-4);
		color: var(--sl-color-white);
		text-decoration: none;
	}
	.vd-btn:hover {
		border-color: var(--vd-mark);
	}
	.vd-btn--primary {
		background: var(--vd-mark);
		border-color: var(--vd-mark);
		color: var(--sl-color-black);
	}
	.vd-btn--primary:hover {
		filter: brightness(1.1);
	}
</style>
