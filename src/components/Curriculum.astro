---
// Home page table of contents, built from src/data/curriculum.mjs.
// Topics without a page yet are listed as "planned".
import { getCollection } from 'astro:content';
import { curriculum } from '../data/curriculum.mjs';

const written = new Set((await getCollection('docs')).map((entry) => entry.id));
const href = (slug: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${slug}/`;
const topics = curriculum.flatMap((section) => section.topics);
const writtenCount = topics.filter((t) => written.has(t.slug)).length;
---

<p class="vd-count not-content">
	{
		writtenCount === topics.length ? (
			<>
				<strong>{topics.length}</strong> lessons, in learning order.
			</>
		) : (
			<>
				<strong>{writtenCount}</strong> of {topics.length} lessons written. New lessons are added in this order.
			</>
		)
	}
</p>

<ol class="vd-toc not-content">
	{
		curriculum.map((section) => (
			<li class="vd-section">
				<div class="vd-section__head">
					<span class="vd-num">{section.num}</span>
					<h2>{section.title}</h2>
					<p>{section.blurb}</p>
				</div>
				<ul>
					{section.topics.map((topic) =>
						written.has(topic.slug) ? (
							<li class="is-written">
								<a href={href(topic.slug)}>
									<span>{topic.title}</span>
									<small>read →</small>
								</a>
							</li>
						) : (
							<li class="is-planned">
								<span>{topic.title}</span>
								<small>planned</small>
							</li>
						)
					)}
				</ul>
			</li>
		))
	}
</ol>

<style>
	.vd-toc {
		list-style: none;
		padding: 0;
		margin: 1rem 0 3rem;
		border-top: 2px solid var(--sl-color-gray-4);
	}
	.vd-section {
		display: grid;
		gap: 0.5rem 2rem;
		padding-block: 1.5rem;
		border-bottom: 1px solid var(--sl-color-hairline-light);
	}
	@media (min-width: 50rem) {
		.vd-section {
			grid-template-columns: 18rem 1fr;
		}
	}
	.vd-section__head {
		display: grid;
		grid-template-columns: auto 1fr;
		column-gap: 0.75rem;
		align-content: start;
	}
	.vd-num {
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-sm);
		color: var(--vd-mark);
		padding-top: 0.3rem;
	}
	h2 {
		font-family: var(--vd-font-display);
		font-size: var(--sl-text-2xl);
		font-weight: 600;
		line-height: 1.2;
		margin: 0;
		color: var(--sl-color-white);
	}
	.vd-section__head p {
		grid-column: 2;
		margin: 0.25rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
		align-content: start;
	}
	ul li {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.5rem;
		padding: 0.45rem 0.25rem;
		border-bottom: 1px dotted var(--sl-color-gray-5);
		margin-inline-end: 1.25rem;
	}
	.is-written {
		padding: 0;
		border-bottom-color: var(--vd-mark);
		border-bottom-style: solid;
	}
	.is-written a {
		display: flex;
		flex: 1;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.5rem;
		padding: 0.45rem 0.25rem;
		color: var(--sl-color-white);
		font-weight: 600;
		text-decoration: none;
	}
	.is-written small {
		color: var(--vd-mark);
		font-weight: 600;
	}
	.is-written a:hover,
	.is-written a:focus-visible {
		background: var(--sl-color-accent-low);
	}
	.is-planned span {
		color: var(--sl-color-gray-4);
	}
	.is-planned small {
		color: var(--sl-color-gray-5);
	}
	.vd-count {
		margin-top: 2rem;
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.vd-count strong {
		color: var(--vd-mark);
	}
	small {
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-2xs);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--sl-color-gray-4);
	}
</style>
